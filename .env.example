# Environment Variables Template for Todo Application
# Copy this file to .env.development, .env.staging, or .env.production and fill in the values

# ================================
# APPLICATION SETTINGS
# ================================
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173

# ================================
# DATABASE CONFIGURATION
# ================================
# PostgreSQL Database URL
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todo_dev

# Database connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=todo_dev
DB_USER=postgres
DB_PASSWORD=postgres

# ================================
# REDIS CONFIGURATION (Optional)
# ================================
# Redis URL for caching and sessions
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ================================
# JWT AUTHENTICATION
# ================================
# Secret key for JWT token signing (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ================================
# SECURITY SETTINGS
# ================================
# CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security headers
HELMET_CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline'

# ================================
# LOGGING
# ================================
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE_PATH=./logs/app.log

# ================================
# FILE UPLOADS
# ================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# ================================
# EMAIL CONFIGURATION (Optional)
# ================================
# SMTP settings for email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@example.com

# ================================
# FRONTEND BUILD SETTINGS
# ================================
# API URL for frontend (used during build)
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000

# App metadata
VITE_APP_NAME=Todo App
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Offline-first todo application

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PWA=true
VITE_ENABLE_NOTIFICATIONS=true

# ================================
# CLOUD DEPLOYMENT SETTINGS
# ================================

# Vercel deployment
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-org-id
VERCEL_PROJECT_ID=your-project-id

# Railway deployment
RAILWAY_TOKEN=your-railway-token

# AWS deployment
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket
AWS_CLOUDFRONT_DISTRIBUTION_ID=your-distribution-id

# ================================
# MONITORING & ANALYTICS
# ================================
# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# Google Analytics
GA_TRACKING_ID=GA-XXXXXXXXX-X

# Application insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key

# ================================
# BACKUP CONFIGURATION
# ================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_PREFIX=backups/todo

# ================================
# NOTIFICATION WEBHOOKS
# ================================
# Slack webhook for deployment notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Discord webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook

# ================================
# DEVELOPMENT SETTINGS
# ================================
# Skip certain checks in development
SKIP_TESTS=false
SKIP_LINT=false
SKIP_TYPE_CHECK=false

# Hot reload settings
CHOKIDAR_USEPOLLING=false
FAST_REFRESH=true

# Debug settings
DEBUG=app:*
DEBUG_COLORS=true

# ================================
# PRODUCTION OVERRIDES
# ================================
# These will be different in production

# Production database (use connection pooling)
# DATABASE_URL=postgresql://user:password@prod-db:5432/todo_prod?sslmode=require

# Production Redis (use managed service)
# REDIS_URL=rediss://user:password@redis-prod:6380

# Production JWT secret (use a secure random string)
# JWT_SECRET=production-super-secure-secret-key-minimum-32-characters-long

# Production CORS (restrict to your domains)
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Production logging (use structured logging)
# LOG_LEVEL=warn
# LOG_FORMAT=json

# Production security
# HELMET_CSP_DIRECTIVES=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'

# ================================
# DOCKER COMPOSE OVERRIDES
# ================================
# These are used by docker-compose.yml

POSTGRES_DB=todo_dev
POSTGRES_USER=postgres  
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379
ADMINER_PORT=8080
BACKEND_PORT=3000
FRONTEND_PORT=80